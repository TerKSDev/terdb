{
  "name": "drixx",
  "version": "1.1.0",
  "description": "A lightweight interactive TUI database client",
  "bin": {
    "drix": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx bin/cli.ts",
    "build:cli": "tsup",
    "build:studio": "vite build --config studio/vite.config.ts",
    "build": "pnpm build:cli && pnpm build:studio",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "database",
    "tui",
    "cli",
    "drix"
  ],
  "author": "TerKSDev",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@inquirer/prompts": "^8.5.2",
    "hono": "^4.12.32",
    "mysql2": "^3.23.2",
    "open": "^11.0.0",
    "pg": "^8.22.0",
    "picocolors": "^1.1.1"
  }
}
