{
  "name": "terdb",
  "version": "0.0.1",
  "description": "A lightweight interactive TUI database client",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.js",
  "bin": {
    "terdb": "src/index.js"
  },
  "scripts": {
    "dev": "tsx bin/cli.ts",
    "build": "tsup"
  },
  "keywords": [
    "database",
    "tui",
    "cli",
    "terdb"
  ],
  "author": "TerKSDev",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "picocolors": "^1.1.1"
  }
}
